<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ExampleANSIConsole</AssemblyName>
    <RootNamespace>ExampleANSIConsole</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalPackage)' != 'true'">
    <ProjectReference Include="..\ANSIConsole\ANSIConsole.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalPackage)' == 'true'">
    <PackageReference Include="ANSI.Console" Version="3.0.0" />
  </ItemGroup>
</Project>
