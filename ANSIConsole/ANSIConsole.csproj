<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Authors>Dotch</Authors>
    <Company />
    <Description>Lightweight and flexible text formatter for creating beautiful console applications.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/WilliamRagstad/ANSIConsole</PackageProjectUrl>
    <PackageIcon>logo_cropped.png</PackageIcon>
    <RepositoryUrl>https://github.com/WilliamRagstad/ANSIConsole</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>console, formatting, more, colors, ansi, ascii, lightweight, easy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>ANSI.Console</PackageId>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="..\assets\logo_cropped.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
